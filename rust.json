{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  // Rust repos: github>CowDogMoo/renovate-config:rust
  "description": "Rust repos: one PR per Rust toolchain bump, RUST_VERSION envs tracked in workflows, and automerged Cargo.lock maintenance",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Group every Rust toolchain update into one PR",
      "matchPackageNames": ["rust", "rust-lang/rust"],
      "groupName": "rust-toolchain"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track RUST_VERSION envs in GitHub Actions workflows",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["RUST_VERSION:\\s*[\"']?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']?"],
      "depNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    }
  ]
}
